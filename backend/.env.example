# ---------------------------------------------------------------------------
# Example environment file.
#
# Copy to `.env` and adjust for your machine:   cp .env.example .env
# `.env` is gitignored and must never contain real production secrets.
# This example contains variable NAMES and SAFE SAMPLE VALUES only.
# ---------------------------------------------------------------------------

# Which settings module to load (dev for local work, prod for deployment).
DJANGO_SETTINGS_MODULE=taskflow.settings.dev

# SECURITY: generate your own. Example of how to produce one:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-value

DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO

# --- Database (PostgreSQL) -------------------------------------------------
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
# Host is "db" inside Docker Compose, "localhost" when running natively.
DATABASE_URL=postgres://taskflow:taskflow@localhost:5432/taskflow

# --- Redis -----------------------------------------------------------------
# DB 0 = Celery broker/results, DB 1 = Django cache (kept separate on purpose).
# Host is "redis" inside Docker Compose, "localhost" when running natively.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6379/1

# --- Sessions --------------------------------------------------------------
SESSION_COOKIE_AGE=28800

# --- CORS / CSRF (explicit frontend origins; never use "*") ----------------
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
CSRF_TRUSTED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# --- Email -----------------------------------------------------------------
DEFAULT_FROM_EMAIL=no-reply@taskflow.local
